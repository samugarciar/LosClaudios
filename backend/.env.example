# Copiar a backend/.env y rellenar. backend/.env está ignorado por git.
#
# NUNCA pongas un valor real en este fichero: es una plantilla versionada.
# Si un secreto acaba aquí, el siguiente `git add -A` lo sube al remoto.

# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------
# dev | production. En production, SESSION_SECRET y ANON_HASH_SALT son
# obligatorios y el arranque falla si faltan (en dev se generan efímeros).
ENV=dev

# ---------------------------------------------------------------------------
# Modelo
# ---------------------------------------------------------------------------
# Sin clave, el agente funciona con un modelo simulado y lo registra en el log.
ANTHROPIC_API_KEY=
MODEL=claude-opus-5
# low | medium | high | xhigh | max
EFFORT=high

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Cadena de conexión de Supabase (usa el pooler). Vacío = SIN PERSISTENCIA:
# checkpointer en memoria y repositorios no-op. Útil para desarrollo, inútil
# para cualquier otra cosa.
#
# ⚠️ AVISO PARA EL EQUIPO: la primera vez que arranques con DATABASE_URL
# definido, LangGraph crea AUTOMÁTICAMENTE sus propias tablas en ese esquema
# (checkpoints, checkpoint_blobs, checkpoint_writes, checkpoint_migrations).
# No están en supabase/schema/ porque las gestiona la librería, no nosotros.
# Compartimos base de datos con el equipo de RAG: que no les sorprenda.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Sesión y seguridad
# ---------------------------------------------------------------------------
# Secreto de firma del JWT de sesión. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Sal para hashear IP+User-Agent. La IP en claro NUNCA se almacena (RGPD).
ANON_HASH_SALT=

SESSION_TTL_HOURS=720

# Origen permitido del frontend. En producción, el dominio real.
ALLOWED_ORIGIN=http://localhost:3000

# En producción: COOKIE_SECURE=true (Vercel sirve por HTTPS).
#
# COOKIE_SAMESITE se queda en `lax` aunque frontend y backend estén en dominios
# distintos. El navegador NUNCA contacta con este backend: habla con /api/chat
# en el dominio del frontend, y es el servidor de Next quien reenvía la cookie.
# Desde el navegador la cookie es de primera parte. Usar `none` aquí solo
# debilitaría la protección CSRF sin resolver ningún problema real.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# Límites de abuso (sin login, el endpoint es público)
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=20
MAX_TURNS_PER_SESSION=40
MAX_TOKENS_PER_SESSION=300000
