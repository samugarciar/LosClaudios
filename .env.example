# Copiar a .env.local y ajustar. NO commitear .env.local.
#
# Este fichero solo contiene configuración del FRONTEND. Las claves de modelo,
# la service role de Supabase y cualquier otro secreto viven exclusivamente en
# el backend (README §10) y no deben aparecer aquí en ninguna circunstancia.

# ---------------------------------------------------------------------------
# Backend del agente
# ---------------------------------------------------------------------------
# Vacío  -> modo SIMULADO: /api/chat emite el guion de lib/mock/scenario.ts.
# Con URL -> /api/chat hace proxy del stream SSE al backend FastAPI real.
BACKEND_URL=

# Retardo entre tokens en modo simulado (ms). Solo afecta al desarrollo local.
MOCK_STREAM_DELAY_MS=18

# ---------------------------------------------------------------------------
# Cliente (expuesto al navegador — nada sensible)
# ---------------------------------------------------------------------------
# Idioma por defecto cuando no se puede resolver desde Accept-Language.
NEXT_PUBLIC_DEFAULT_LOCALE=es

# Versión del texto de consentimiento vigente. Se persiste junto al lead para
# poder auditar qué texto legal aceptó exactamente el usuario (README §9).
# Cambiar el texto legal OBLIGA a subir esta versión.
NEXT_PUBLIC_CONSENT_TEXT_VERSION=2026-07-25.v1
